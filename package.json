{
  "name": "reservations",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @reservations/api db:migrate",
    "test": "pnpm -r test",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@usebruno/cli": "4.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
