meta {
  name: check order: an invalid interval wins over an unknown resource
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {"id": "V6", "resource": "R9", "start": 20, "end": 10}
}

assert {
  res.status: eq 422
  res.body.error.code: eq "invalid_data"
}
