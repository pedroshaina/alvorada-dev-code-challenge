meta {
  name: RULE-2 C on R1 [19,21) conflicts with A and B
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {"id": "C", "resource": "R1", "start": 19, "end": 21}
}

assert {
  res.status: eq 409
  res.body.error.code: eq "conflict"
  res.body.error.details.conflicts: length 2
  res.body.error.details.conflicts[0].id: eq "A"
  res.body.error.details.conflicts[1].id: eq "B"
}
